# Upstream data source (https://serper.dev — free tier available)
SERPER_API_KEY=

# Base mainnet wallet that RECEIVES payments (NOT a private key — just the address)
PAY_TO_ADDRESS=

# Public URL of the deployed server (used in x402 payment requirements)
PUBLIC_URL=

# Unset MOCK_MODE in production (it accepts any payment header without verification!)
# MOCK_MODE=1

# Optional: alternative facilitator
# X402_FACILITATOR_URL=https://x402.org/facilitators/coinbase

# Optional: telemetry dir (default ./telemetry)
# TELEMETRY_DIR=
