# Upstream live web search (https://serper.dev)
SERPER_API_KEY=

# Public Base mainnet wallet address that receives USDC (never a private key)
PAY_TO_ADDRESS=

# Final deployed origin, no trailing slash
PUBLIC_URL=https://your-domain.example

# Production x402 V2 facilitator. XPay is open/no-auth and supports Base mainnet.
X402_FACILITATOR_URL=https://facilitator.xpay.sh

# Optional manual tx-hash fallback. Disabled by default because durable replay
# state is required in serverless production. Enable only for controlled testing.
# ALLOW_TX_HASH_FALLBACK=1
# ALCHEMY_URL=https://base-mainnet.g.alchemy.com/v2/your-key

# MOCK_MODE=1  # local tests only; NEVER set in production
# TELEMETRY_DIR=./telemetry

# Durable production telemetry. Vercel adds this automatically when a private
# Blob store is connected to the project. Never commit the token value.
# BLOB_READ_WRITE_TOKEN=

# Dedicated secret used to create pseudonymous wallet identifiers in telemetry.
# TELEMETRY_HASH_KEY=
